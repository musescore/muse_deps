uint64_t needs <cstdint>; the file only pulls <time.h>. Breaks the build
with gcc-16 (stricter libstdc++ header pruning). Same fix as
getsentry/crashpad@bd3f93d0, placed per Chromium include order.
Upstream: https://issues.chromium.org/issues/562705535

diff --git a/util/file/filesystem.h b/util/file/filesystem.h
--- a/util/file/filesystem.h
+++ b/util/file/filesystem.h
@@ -17,6 +17,8 @@
 
 #include <time.h>
 
+#include <cstdint>
+
 #include "base/files/file_path.h"
 #include "util/file/file_io.h"
 
